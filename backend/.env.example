# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.
# Free key: https://aistudio.google.com/apikey
# Note: on Gemini's free tier, Google may use prompts to improve its products,
# so don't upload confidential data while on the free tier.
GEMINI_API_KEY=

# Optional overrides
DATAPILOT_MODEL=gemini-3.5-flash-lite
DATAPILOT_THINKING_LEVEL=LOW
DATAPILOT_MAX_STEPS=8
DATAPILOT_MAX_UPLOAD_MB=10
DATAPILOT_CORS_ORIGINS=http://localhost:5173
